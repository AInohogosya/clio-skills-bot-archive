# Copy this file to .env and fill in real values. Never commit .env to git.

# HTTP server
PORT=3000
# HOST=127.0.0.1        # bind address (defaults: 127.0.0.1 in dev, 0.0.0.0 in production)

# MySQL connection (required for conversations, favorites, catalog sync history)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/clio_skills_bot

# Session signing secret (generate a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret

# OAuth / identity provider
OAUTH_SERVER_URL=https://your-oauth-server.example.com
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal.example.com
VITE_APP_ID=your-app-id
OWNER_OPEN_ID=your-owner-open-id

# Optional: enables DeepL translation instead of public fallback services
# DEEPL_AUTH_KEY=your-deepl-auth-key

# Optional: backend service used for scheduled-task heartbeats and owner notifications
# BUILT_IN_FORGE_API_URL=https://your-forge-api.example.com
# BUILT_IN_FORGE_API_KEY=your-forge-api-key

# Client display title
VITE_APP_TITLE=Clio Skills Bot
